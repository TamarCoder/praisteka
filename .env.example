# ─────────────────────────────────────────────────────────────
# praisteka — example (copy to .env.local)
# NEXT_PUBLIC_* values are built into the browser bundle: never put secrets here.
# ─────────────────────────────────────────────────────────────

# praisteka-backend address (no trailing slash). Read by src/api/fetcher.ts
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public address of this site: sitemap, robots, Open Graph. Read by src/app/site.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000
